---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for sitemap_page in site.pages %}
  {% unless sitemap_page.sitemap == false or sitemap_page.url == '/404.html' or sitemap_page.url == '/robots.txt' or sitemap_page.url == '/sitemap.xml' or sitemap_page.url contains '/feed.xml' %}
  <url>
    <loc>{{ sitemap_page.url | absolute_url | xml_escape }}</loc>
    {% if sitemap_page.last_modified_at %}<lastmod>{{ sitemap_page.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endunless %}
{% endfor %}
{% for meetup in site.data.meetups %}
  {% assign meetup_slug = meetup.title | slugify %}
  {% capture meetup_url %}/event/?event={{ meetup_slug }}{% endcapture %}
  <url>
    <loc>{{ meetup_url | absolute_url | xml_escape }}</loc>
  </url>
{% endfor %}
{% for news_item in site.news %}
  {% unless news_item.sitemap == false %}
  <url>
    <loc>{{ news_item.url | absolute_url | xml_escape }}</loc>
    {% if news_item.last_modified_at %}<lastmod>{{ news_item.last_modified_at | date_to_xmlschema }}</lastmod>{% elsif news_item.scheduled_date %}<lastmod>{{ news_item.scheduled_date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endunless %}
{% endfor %}
{% for post in site.posts %}
  {% unless post.sitemap == false %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    {% if post.last_modified_at %}<lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>{% elsif post.date %}<lastmod>{{ post.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endunless %}
{% endfor %}
</urlset>
